<Window x:Class="YoableSeg.AutoLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Auto Label with SAM3" 
        Height="675" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Positive Prompts (what to detect)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock Text="Enter prompts to detect (one per line). All detections will use the currently selected class:" 
                       Foreground="Gray" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBox x:Name="PromptsTextBox" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap"
                     Height="80"
                     VerticalScrollBarVisibility="Auto"
                     Text="person"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Negative Prompts (what to exclude)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock Text="Optional: Objects matching these prompts will be excluded (e.g., 'gun' to avoid labeling guns held by people):" 
                       Foreground="Gray" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBox x:Name="NegativePromptsTextBox" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap"
                     Height="60"
                     VerticalScrollBarVisibility="Auto"
                     Text=""/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Settings" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,10">
                    <TextBlock Text="Score Threshold:" Margin="0,0,0,5"/>
                    <Slider x:Name="ScoreThresholdSlider" 
                            Minimum="0" Maximum="1" Value="0.5"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="ScoreThresholdValue" Text="0.50"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="10,0,0,10">
                    <TextBlock Text="Mask Threshold:" Margin="0,0,0,5"/>
                    <Slider x:Name="MaskThresholdSlider" 
                            Minimum="0" Maximum="1" Value="0.5"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="MaskThresholdValue" Text="0.50"/>
                </StackPanel>
                
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                    <TextBlock Text="Max Instances:" Margin="0,0,0,5"/>
                    <Slider x:Name="MaxInstancesSlider" 
                            Minimum="1" Maximum="100" Value="50"
                            TickFrequency="5" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="MaxInstancesValue" Text="50"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RunButton" Content="Start Auto Labeling" 
                    Click="Run_Click" Width="150" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="Cancel_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>

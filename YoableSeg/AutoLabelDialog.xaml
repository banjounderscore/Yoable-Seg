<Window x:Class="YoableSeg.AutoLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Auto Label with GroundingDINO + SAM3" 
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Text Prompts" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock Text="Enter prompts to detect (one per line):" 
                       Foreground="Gray" FontSize="12" Margin="0,0,0,8"/>
            <TextBox x:Name="PromptsTextBox" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap"
                     Height="100"
                     VerticalScrollBarVisibility="Auto"
                     Text="humanoid character&#x0a;human-shaped body&#x0a;player character"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Prompt to Class Mapping" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock Text="Assign each prompt to a class:" 
                       Foreground="Gray" FontSize="12" Margin="0,0,0,8"/>
            <ListView x:Name="MappingListView" 
                      Height="120"
                      BorderBrush="Gray"
                      BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Prompt" Width="200" DisplayMemberBinding="{Binding Prompt}"/>
                        <GridViewColumn Header="Class" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableClasses}"
                                              SelectedItem="{Binding SelectedClass}"
                                              DisplayMemberPath="Name"
                                              Width="170"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <Button Content="Update Mapping" Click="UpdateMapping_Click" 
                    Margin="0,8,0,0" HorizontalAlignment="Left"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Thresholds" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,10">
                    <TextBlock Text="Text Threshold:" Margin="0,0,0,5"/>
                    <Slider x:Name="TextThresholdSlider" 
                            Minimum="0" Maximum="1" Value="0.25"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="TextThresholdValue" Text="0.25"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="10,0,0,10">
                    <TextBlock Text="Box Threshold:" Margin="0,0,0,5"/>
                    <Slider x:Name="BoxThresholdSlider" 
                            Minimum="0" Maximum="1" Value="0.25"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="BoxThresholdValue" Text="0.25"/>
                </StackPanel>
                
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                    <TextBlock Text="Max Instances:" Margin="0,0,0,5"/>
                    <Slider x:Name="MaxInstancesSlider" 
                            Minimum="1" Maximum="100" Value="50"
                            TickFrequency="5" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="MaxInstancesValue" Text="50"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RunButton" Content="Start Auto Labeling" 
                    Click="Run_Click" Width="150" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="Cancel_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
